import { Theme } from "../theme.slint";

export component StatusLine inherits HorizontalLayout {
    in property <string> text;
    in property <int> tone: 0;
    in property <bool> align-end: false;
    in property <bool> multiline: false;

    min-height: root.multiline ? 36px : 20px;
    max-height: root.multiline ? 36px : 20px;
    vertical-stretch: 0;
    spacing: 8px;
    alignment: root.align-end ? end : start;

    Rectangle {
        width: 8px;
        height: 8px;
        border-radius: 4px;
        horizontal-stretch: 0;
        background: root.tone == 1 ? Theme.success
            : root.tone == 2 ? Theme.warning
            : root.tone == 3 ? Theme.danger
            : Theme.text-muted;
    }

    Text {
        horizontal-stretch: root.align-end ? 0 : 1;
        text: root.text;
        color: root.tone == 1 ? Theme.success
            : root.tone == 2 ? Theme.warning
            : root.tone == 3 ? Theme.danger
            : Theme.text-secondary;
        font-size: 12px;
        overflow: root.multiline ? clip : elide;
        wrap: root.multiline ? word-wrap : no-wrap;
        horizontal-alignment: root.align-end ? right : left;
        vertical-alignment: center;
    }
}
